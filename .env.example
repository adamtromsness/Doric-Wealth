# --- Database ---
# Privileged connection (owner/admin): used for migrations, bootstrap, and the
# db-role setup script. Matches docker-compose.yml.
DATABASE_URL=postgresql://finance:finance@localhost:5433/finance
# Connection the running server uses. Point this at a NON-superuser role (create it
# with `cd server && APP_DB_USER=finance_app APP_DB_PASSWORD=... npm run setup:db-role`)
# so Postgres row-level security is enforced — superusers bypass RLS. Unset = falls
# back to DATABASE_URL (fine for local dev; RLS then relies on the app-layer scoping).
# APP_DATABASE_URL=postgresql://finance_app:your-password@localhost:5433/finance
# Max pooled DB connections (each in-flight request holds one). Default 20.
# DB_POOL_MAX=20

# --- Server ---
PORT=4000
# Network interface to bind. Loopback by default; set 0.0.0.0 to expose it (behind
# TLS — see COOKIE_SECURE). Required when running in a container.
HOST=127.0.0.1

# --- Auth / multi-tenancy ---
# Users log in with email + password; data belongs to a book, shareable with
# family via invite codes. Sessions are httpOnly cookies. The flags below default
# to ON in production (NODE_ENV=production) and OFF for local http dev.
# COOKIE_SECURE=true    # send the session cookie over HTTPS only
# TRUST_PROXY=true      # trust X-Forwarded-* from a single upstream proxy (ALB)
# Public base URL, used to build shareable invite links (else links are relative).
# APP_BASE_URL=https://app.example.com
# Optional CORS origin lock (only needed if the SPA is served from another origin).
# WEB_ORIGIN=https://app.example.com

# --- Secrets ---
# Encrypts stored third-party credentials (e.g. a linked SimpleFIN access URL) at
# rest. Generate one with: openssl rand -base64 32
# In production the server REFUSES TO START if this is missing, still the built-in
# development default, or shorter than 32 characters. Left blank, local dev falls
# back to an insecure constant that is public in this repository.
# APP_SECRET_KEY=

# --- AI analysis (Anthropic) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Any current model string works. Good options:
#   claude-sonnet-4-6  (balanced default)
#   claude-haiku-4-5-20251001  (cheaper / faster)
#   claude-opus-4-8  (most capable)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Property values (RentCast AVM, optional) ---
# Free tier key from https://app.rentcast.io/app/api. If unset, property value
# estimates fall back to an AI estimate.
RENTCAST_API_KEY=
