{
  "name": "finance-tracker-server",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "bootstrap": "tsx src/bootstrap.ts",
    "setup:db-role": "tsx src/setupDbRole.ts",
    "test": "npm run test:integration",
    "test:integration": "tsx test/prepare-db.ts && node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:coverage": "tsx test/prepare-db.ts && c8 node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:coverage:gate": "tsx test/prepare-db.ts && c8 --check-coverage --lines 90 node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "c8": "^12.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
