# Template for .env.production — generate the real file with
# scripts/local-prod/init-env.sh (it fills in random secrets).
POSTGRES_PASSWORD=
APP_DB_USER=doric_app
APP_DB_PASSWORD=
APP_SECRET_KEY=
BACKUP_DIR=/mnt/c/Users/<you>/DoricBackups
BACKUP_KEEP_DAYS=30
ANTHROPIC_API_KEY=
RENTCAST_API_KEY=
# Optional outgoing email (password reset links), e.g. OCI Email Delivery or Amazon SES:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional: contact for privacy questions and data deletion, shown on the Privacy page:
CONTACT_EMAIL=
# Optional: copy backups off the machine to an S3-compatible bucket (e.g. OCI Object
# Storage via its S3 API: ENDPOINT https://<namespace>.compat.objectstorage.<region>.oraclecloud.com,
# REGION <region>, keys from "Customer Secret Keys"). Leave OFFSITE_BUCKET empty to disable.
OFFSITE_BUCKET=
OFFSITE_PREFIX=doric
OFFSITE_PROVIDER=Other
OFFSITE_ENDPOINT=
OFFSITE_REGION=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
